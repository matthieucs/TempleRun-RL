# scratchpad: KEEP the analysis tools (*.py), the training recipes (*.sh) and the
# sim configs (*_cfg.json) — they are how every arm in CLAUDE.md is reproduced.
# DROP the rollout/eval data dumps.
scratchpad/*.jsonl
scratchpad/*.json
!scratchpad/*_cfg*.json
scratchpad/*.err
scratchpad/*.out
scratchpad/*.pt
scratchpad/*.html
scratchpad/*.bak.py
scratchpad/_t.cpp

# --- champion weights: re-included from the runs/ + *.zip ban above ---
!models/*.zip
